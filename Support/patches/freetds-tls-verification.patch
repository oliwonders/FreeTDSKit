+/**
+ * \ingroup dblib_core
+ * \brief FreeTDSKit extension: verify the server's TLS certificate.
+ *
+ * \param login the \c LOGINREC* to modify.
+ * \param cafile PEM file of trusted CA certificates. NULL or "" turns
+ *        verification off (unless encryption is "strict", which always
+ *        verifies). Unlike dbsetlname values, not capped at
+ *        TDS_MAX_LOGIN_STR_SZ: a sandbox container path is longer than that.
+ * \param certificate_host_name name the certificate must match; NULL or ""
+ *        means the server's host name.
+ * \retval SUCCEED the values were set.
+ * \retval FAIL \a login was NULL or memory ran out.
+ */
+RETCODE
+dbsetltlsverify(LOGINREC * login, const char *cafile, const char *certificate_host_name)
+{
+	tdsdump_log(TDS_DBG_FUNC, "dbsetltlsverify(%p, %s, %s)\n", login, cafile, certificate_host_name);
+
+	if (login == NULL) {
+		dbperror(NULL, SYBEASNL, 0);
+		return FAIL;
+	}
+	if (!tds_dstr_copy(&login->tds_login->cafile, cafile ? cafile : ""))
+		return FAIL;
+	if (!tds_dstr_copy(&login->tds_login->certificate_host_name,
+			   certificate_host_name ? certificate_host_name : ""))
+		return FAIL;
+	return SUCCEED;
+}
+
